# ===============================
# 🔑 Wallet & Blockchain Settings
# ===============================

# Your private key for the wallet (must be 64 hex chars prefixed with 0x).
# Example: 0xabcdef1234... (never share this in public repos!)
# Used in src/vercel/index.ts
PRIVATE_KEY=

# ChainId identifier. Should match the configId passed to BOSON_MCP_URL when prompting the AI.
# Example for Base Sepolia on staging environment: configId: staging-84532-0, chainId: 84532
CHAIN_ID=84532


# ===============================
# 🤖 AI / Anthropic Settings
# ===============================

# Anthropic API key for Claude models.
# Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===============================
# 🛠 Boson MCP Server Config
# ===============================

# For testing with staging MCP server
BOSON_MCP_URL=https://mcp-staging.bosonprotocol.io/mcp
# or this url for production
# BOSON_MCP_URL=https://mcp.bosonprotocol.io/mcp

# ===============================
# 🛠 Boson XMTP MCP Server Config
# ===============================
# The XMTP MCP server is no longer publicly hosted — you deploy it yourself.
#
# Default (stdio): leave XMTP_BOSON_MCP_URL UNSET. The example spawns
#   `npx boson-xmtp-mcp-server` locally and forwards PRIVATE_KEY to it as
#   BOSON_XMTP_PRIVATE_KEY automatically.
#
# Optional (self-hosted HTTP): run your own server (see README.md), then point
#   the example at your PRIVATE url:
# XMTP_BOSON_MCP_URL=http://127.0.0.1:3000/mcp



